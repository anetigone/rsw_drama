# API Base URL
VITE_API_BASE_URL=http://localhost:3000/api

# 云函数基础 URL（用于问卷分析等功能）
# 腾讯云示例: https://service-xxx-xxx.gz.apigw.tencentcs.com
# 阿里云示例: https://xxx.cn-hangzhou.fc.aliyuncs.com
# 自定义域名示例: https://api.yourdomain.com
VITE_CLOUD_FUNCTION_URL=https://api.newsouthwest.cn

# 文件上传大小限制（单位：MB）
VITE_MAX_FILE_SIZE=50

# ========== LLM API 配置（用于本地测试）==========
# 启用本地测试模式（true=本地直接调用LLM API，false=使用云函数）
VITE_ENABLE_LOCAL_LLM=false

# LLM API 配置
# DeepSeek 示例（推荐）:
VITE_LLM_API_KEY=sk-a4b4145b2a45494cb6cba0e11fbc5d5b
VITE_LLM_BASE_URL=https://api.deepseek.com/v1
VITE_LLM_MODEL=deepseek-chat

# OpenAI 示例:
# VITE_LLM_API_KEY=sk-your-openai-api-key
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_MODEL=gpt-4

# 阿里云通义千问示例:
# VITE_LLM_API_KEY=sk-your-qwen-api-key
# VITE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VITE_LLM_MODEL=qwen-plus

# LLM 参数配置（可选）
VITE_LLM_TEMPERATURE=0.7
VITE_LLM_MAX_TOKENS=4000

# 其他配置可以在这里添加
